def sieveCofactor (s : ℕ) : Prop := s=5 ∨ s=6 ∨ s=7 ∨ s=8 ∨ s=10 ∨ s=14 ∨ s=21 ∨ s=30 ∨ s=33 ∨ s=66
instance (s : ℕ) : Decidable (sieveCofactor s) := by unfold sieveCofactor; infer_instance

def sieveLine (p s : ℕ) : Prop :=
  (p=3 ∧ s=7) ∨ (p=7 ∧ s=8) ∨
  quotientCertificate p s p (sieveData p s).1 (sieveData p s).2.1 (sieveData p s).2.2.1 (sieveData p s).2.2.2
instance (p s : ℕ) : Decidable (sieveLine p s) := by unfold sieveLine; infer_instance

set_option maxRecDepth 100000 in
theorem sieve_valid : ∀ p : Fin 132, ∀ s : Fin 67, sieveCofactor s.val → p.val.Prime →
    3≤p.val → p.val<2*s.val → ¬ p.val ∣ s.val → sieveLine p.val s.val := by decide +kernel

