import Mathlib.Algebra.MvPolynomial.Degrees
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import Mathlib.RingTheory.Artinian.Algebra
import Mathlib.Tactic

/-! A simultaneous degree reduction proves integrality of the entries in
a translated affine slice. Each pure d-th power is expressed in total
degree strictly less than d in all the same generators. -/
noncomputable section
namespace DegreeDrop
open Finset MvPolynomial
variable {K A I : Type*} [Field K] [CommRing A] [Algebra K A] [Fintype I] [DecidableEq I]

private def productAt (u : I → A) (e : I → ℕ) : A := ∏ j, u j ^ e j

omit [DecidableEq I] in
private theorem product_add (u : I → A) (e f : I → ℕ) :
    productAt u (e+f) = productAt u e * productAt u f := by
  simp [productAt,Pi.add_apply,pow_add,Finset.prod_mul_distrib]

private theorem product_single (u : I → A) (i : I) (d : ℕ) :
    productAt u (Pi.single i d) = u i ^ d := by
  unfold productAt
  rw [Finset.prod_eq_single i]
  · simp
  · intro j _ ne
    simp [Pi.single_eq_of_ne ne]
  · simp

omit [DecidableEq I] in
private theorem weight_add (e f : I → ℕ) :
    (∑ j, (e+f) j) = (∑ j, e j)+(∑ j, f j) := by
  simp [Pi.add_apply,Finset.sum_add_distrib]

private theorem weight_single (i : I) (d : ℕ) : (∑ j, (Pi.single i d : I → ℕ) j) = d := by
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ ne
    exact Pi.single_eq_of_ne ne _
  · simp

omit [DecidableEq I] in
private theorem weight_monomial (p : MvPolynomial I K) (s : I →₀ ℕ) (hs : s ∈ p.support) :
    (∑ i, s i) ≤ p.totalDegree := by
  have h := MvPolynomial.le_totalDegree hs
  rwa [Finsupp.sum_fintype] at h
  intros
  rfl

/-- A multivariate analogue of reduction by monic equations. The bounded
monomials span the algebra generated by u as a vector space over K. -/
theorem integral_of_power_degree_drop (u : I → A) (d : ℕ)
    (rel : ∀ i, ∃ p : MvPolynomial I K, p.totalDegree < d ∧
      u i ^ d = p.eval₂ (algebraMap K A) u) (i : I) : IsIntegral K (u i) := by
  classical
  let small (g : I → Fin d) := productAt u (fun j ↦ (g j).val)
  let N := Submodule.span K (Set.range small)
  have contains (e : I → ℕ) : productAt u e ∈ N := by
    generalize deg : (∑ j, e j) = m
    induction m using Nat.strong_induction_on generalizing e with
    | ind m ih =>
      by_cases bounded : ∀ j, e j < d
      · exact Submodule.subset_span ⟨fun j ↦ ⟨e j,bounded j⟩,rfl⟩
      push Not at bounded
      obtain ⟨j,hj⟩ := bounded
      let f (k : I) := if k = j then e k - d else e k
      have split : e = f + Pi.single j d := by
        funext k
        by_cases eq : k = j
        · subst k; simp [f,Nat.sub_add_cancel hj]
        · simp [f,eq]
      have total : (∑ k, f k) + d = m := by
        rw [← weight_single j d,← weight_add,← split,deg]
      rw [split,product_add,product_single]
      obtain ⟨p,hd,hp⟩ := rel j
      rw [hp,MvPolynomial.eval₂_eq',Finset.mul_sum]
      apply N.sum_mem
      intro s hs
      have ds := weight_monomial p s hs
      have less : (∑ k, (f+fun k ↦ s k) k) < m := by rw [weight_add]; omega
      have hin := ih _ less (f+fun k ↦ s k) rfl
      rw [product_add] at hin
      have scaled := N.smul_mem (p.coeff s) hin
      simpa only [Algebra.smul_def,productAt,mul_left_comm] using scaled
  let B := (MvPolynomial.aeval u : MvPolynomial I K →ₐ[K] A).range
  have eq : B.toSubmodule = N := by
    apply le_antisymm
    · rintro x ⟨p,rfl⟩
      change p.eval₂ (algebraMap K A) u ∈ N
      rw [MvPolynomial.eval₂_eq']
      apply N.sum_mem
      intro s _
      simpa only [Algebra.smul_def,productAt] using N.smul_mem (p.coeff s) (contains (fun k ↦ s k))
    · apply Submodule.span_le.mpr
      rintro _ ⟨e,rfl⟩
      refine ⟨∏ j, (X j : MvPolynomial I K) ^ (e j).val,?_⟩
      simp [small,productAt]
  apply IsIntegral.of_mem_of_fg B
  · rw [eq]
    exact Submodule.fg_span (Set.finite_range small)
  · exact ⟨X i,by simp⟩

/-- In an integral algebra an integral element killed by a homomorphism to
a nonzero ring vanishes. A nonzero integral element would be a unit. -/
theorem zero_of_integral_map_zero {B : Type*} [CommRing B] [Nontrivial B] [IsDomain A]
    (f : A →+* B) (x : A) (integral : IsIntegral K x) (atZero : f x = 0) : x = 0 := by
  by_contra nz
  have unit := IsArtinianRing.isUnit_of_isIntegral_of_nonZeroDivisor integral (mem_nonZeroDivisors_of_ne_zero nz)
  exact (unit.map f).ne_zero atZero

#print axioms integral_of_power_degree_drop
#print axioms zero_of_integral_map_zero
end DegreeDrop
