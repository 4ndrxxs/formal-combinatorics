import PermanentBorderJets

/-! Ranks of a direct sum, an off-diagonal cofactor block, and a
symmetric border generated by an isotropic column. -/
noncomputable section
open Matrix Module Finset
namespace PermanentBorder
variable {K J L : Type*} [Field K] [Fintype J] [Fintype L]

theorem sum_rank (A : Matrix J J K) (B : Matrix L L K) :
    (Matrix.fromBlocks A 0 0 B).rank=A.rank+B.rank := by
  let S := (Matrix.fromBlocks A 0 0 B).mulVecLin
  let e := LinearEquiv.sumArrowLequivProdArrow J L K K
  have action (w : J ⊕ L → K) :
      e (S w)=(A *ᵥ (w ∘ Sum.inl),B *ᵥ (w ∘ Sum.inr)) := by
    change ((S w) ∘ Sum.inl,(S w) ∘ Sum.inr)=_
    simp [S,Matrix.fromBlocks_mulVec,Function.comp_def]
  have image : Submodule.map e.toLinearMap S.range=A.mulVecLin.range.prod B.mulVecLin.range := by
    ext y
    constructor
    · rintro ⟨_,⟨w,rfl⟩,rfl⟩
      rw [LinearEquiv.coe_coe,action]
      exact ⟨⟨_,rfl⟩,⟨_,rfl⟩⟩
    · rintro ⟨⟨u,hu⟩,⟨v,hv⟩⟩
      refine ⟨_,⟨Sum.elim u v,rfl⟩,?_⟩
      rw [LinearEquiv.coe_coe,action]
      exact Prod.ext hu hv
  change finrank K S.range=_
  rw [(Submodule.equivMapOfInjective e.toLinearMap e.injective S.range).finrank_eq,image,
    (Submodule.prodEquiv _ _).finrank_eq,Module.finrank_prod]
  rfl

theorem cross_rank (A : Matrix J J K) :
    (Matrix.fromBlocks (0:Matrix J J K) A Aᵀ 0).rank=2*A.rank := by
  let T := Matrix.fromBlocks (0:Matrix J J K) A Aᵀ 0
  have sub : T.submatrix id (Equiv.sumComm J J)=Matrix.fromBlocks A 0 0 Aᵀ := by
    ext (i|i) (j|j) <;> rfl
  have eq := Matrix.rank_submatrix T (Equiv.refl _) (Equiv.sumComm J J)
  change (T.submatrix id (Equiv.sumComm J J)).rank=T.rank at eq
  rw [sub,sum_rank,Matrix.rank_transpose] at eq
  change T.rank=_
  omega

def arrow (H : Matrix J J K) (g : J → K) : Matrix (J ⊕ Unit) (J ⊕ Unit) K :=
  Matrix.fromBlocks H (Matrix.of fun i _ ↦ g i) (Matrix.of fun _ j ↦ g j) 0

theorem arrow_rank (H : Matrix J J K) (g w : J → K) (sym : ∀ i j, H i j=H j i)
    (image : H *ᵥ w=g) (null : g ⬝ᵥ w=0) : (arrow H g).rank=H.rank := by
  classical
  let S : Matrix (J ⊕ Unit) J K := Matrix.of fun u i ↦
    Sum.elim (fun j ↦ (1:Matrix J J K) j i) (fun _ ↦ w i) u
  let T := (arrow H g).submatrix id Sum.inl
  have row (j : J) : (∑ k, w k*H k j)=g j := by
    calc _=∑ k, H j k*w k := Finset.sum_congr rfl fun k _ ↦ by rw [sym k j,mul_comm]
         _=g j := congrFun image j
  have first : T=S*H := by
    ext (i|i) j
    · simp [T,arrow,S,Matrix.mul_apply,Matrix.one_apply,ite_mul]
    · exact (row j).symm
  have second : arrow H g = T*Sᵀ := by
    ext (i|i) (j|j)
    · simp [T,arrow,S,Matrix.mul_apply,Matrix.one_apply,Function.swap,mul_ite]
    · exact (congrFun image i).symm
    · simp [T,arrow,S,Matrix.mul_apply,Matrix.one_apply,Function.swap,mul_ite]
    · exact null.symm
  have low := Matrix.rank_submatrix_le (arrow H g) (Sum.inl : J → J ⊕ Unit)
    (Sum.inl : J → J ⊕ Unit)
  change H.rank≤(arrow H g).rank at low
  refine le_antisymm ?_ low
  calc (arrow H g).rank=(T*Sᵀ).rank := congrArg Matrix.rank second
       _≤T.rank := Matrix.rank_mul_le_left _ _
       _=(S*H).rank := congrArg Matrix.rank first
       _≤H.rank := Matrix.rank_mul_le_right _ _

#print axioms sum_rank
#print axioms arrow_rank
end PermanentBorder
