private def rowLaw (i : ℕ) : Prop := ∀ j k : Fin 49,
  let a := numbers (Fin.ofNat 49 i)
  let b := numbers j
  let c := numbers k
  a+b+c=a+(b+c) ∧ a*b*c=a*(b*c) ∧ a*(b+c)=a*b+a*c

private instance (i : ℕ) : Decidable (rowLaw i) := by unfold rowLaw; infer_instance

