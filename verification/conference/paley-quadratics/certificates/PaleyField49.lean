    nonsquare (.split true false) PaleyBits49.SplitNonsquaresOpposite.indexing diags]
  exact PaleyBits49.SplitNonsquaresOpposite.determinant_bound


private theorem boundNonsplitNegative :
    fourFifths 49 ≤ signedDet ((.nonsplit false : Pattern).sign nonsquare) := by
  have diags : ∀i : Fin 25 ⊕ Fin 25,
      (.nonsplit false : Pattern).read readChar nonsquare (chart numbers (PaleyBits49.NonsplitNegative.indexing i))
      =Sum.elim (fun _ ↦ (1:ℤ)) (fun _ ↦ -1) i := by decide +kernel
  rw [determinant_from_table numbers readChar character PaleyBits49.fullRows entries
    nonsquare (.nonsplit false) PaleyBits49.NonsplitNegative.indexing diags]
  exact PaleyBits49.NonsplitNegative.determinant_bound


private theorem boundNonsplitNegativeOpposite :
    fourFifths 49 ≤ signedDet ((.nonsplit true : Pattern).sign nonsquare) := by
  have diags : ∀i : Fin 25 ⊕ Fin 25,
      (.nonsplit true : Pattern).read readChar nonsquare (chart numbers (PaleyBits49.NonsplitNegativeOpposite.indexing i))
      =Sum.elim (fun _ ↦ (1:ℤ)) (fun _ ↦ -1) i := by decide +kernel
  rw [determinant_from_table numbers readChar character PaleyBits49.fullRows entries
    nonsquare (.nonsplit true) PaleyBits49.NonsplitNegativeOpposite.indexing diags]
  exact PaleyBits49.NonsplitNegativeOpposite.determinant_bound


theorem canonical : CertifiedPatterns Element := by
  refine ⟨nonsquare,negative,?_⟩
  intro pat
  rw [card]
  cases pat with
  | split o z =>
    cases o <;> cases z
    · exact boundSplitSquaresOpposite
    · exact boundSplitNonsquares
    · exact boundSplitNonsquaresOpposite
    · exact boundSplitSquares
  | nonsplit o =>
    cases o
    · exact boundNonsplitNegative
    · exact boundNonsplitNegativeOpposite

#print axioms canonical
end PaleyField49
