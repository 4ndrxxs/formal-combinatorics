instance : Field Element := Field.ofMinimalAxioms Element
  (fun a b c ↦ (laws a b c).1) (by decide +kernel) (by decide +kernel)
  (fun a b c ↦ (laws a b c).2.1) (by decide +kernel) (by decide +kernel)
  (by decide +kernel) (by decide +kernel) (fun a b c ↦ (laws a b c).2.2)
  ⟨numbers 0,numbers 1,by decide +kernel⟩

private def encode (u : Element) : ℕ := u.rep.val


private def readChar (u : Element) : ℤ :=
  if encode u=0 then 0 else if (1997949203421680987662102:ℕ).testBit (encode u) then 1 else -1

private theorem character : ∀u, readChar u=quadraticChar Element u :=
  character_by_squares readChar (by decide +kernel) (by decide +kernel) (by decide +kernel)

def nonsquare : Element := numbers 3
private theorem negative : quadraticChar Element nonsquare= -1 := by
  rw [←character]; decide +kernel

private theorem entries : ∀i j : Fin 82, tableEntry readChar (chart numbers i) (chart numbers j)=
    sign (PaleyBits81.fullRows i) j.val - (if i=j then 1 else 0 : ℤ) := by decide +kernel

theorem card : Fintype.card Element=81 := (Fintype.card_congr numbers.symm).trans (Fintype.card_fin _)


private theorem boundSplitSquares :
    fourFifths 81 ≤ signedDet ((.split true true : Pattern).sign nonsquare) := by
  have diags : ∀i : Fin 41 ⊕ Fin 41,
      (.split true true : Pattern).read readChar nonsquare (chart numbers (PaleyBits81.SplitSquares.indexing i))
      =Sum.elim (fun _ ↦ (1:ℤ)) (fun _ ↦ -1) i := by decide +kernel
  rw [determinant_from_table numbers readChar character PaleyBits81.fullRows entries
    nonsquare (.split true true) PaleyBits81.SplitSquares.indexing diags]
  exact PaleyBits81.SplitSquares.determinant_bound


private theorem boundSplitNonsquares :
    fourFifths 81 ≤ signedDet ((.split false true : Pattern).sign nonsquare) := by
