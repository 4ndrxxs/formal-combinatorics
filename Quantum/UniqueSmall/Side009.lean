private theorem all_checked : Interval test 0 382 := (interval_join (interval_join (interval_join (interval_join block0 block1) (interval_join block2 block3)) (interval_join (interval_join block4 block5) (interval_join block6 block7))) (interval_join (interval_join (interval_join block8 block9) (interval_join block10 block11)) (interval_join (interval_join block12 block13) (interval_join block14 block15))))
private theorem forced (g : Active) (good : Good g) : ∀ r i,g 0 r i=i :=
  force 1115 382 tag cl hints (by decide) (fun i h => all_checked i (Nat.zero_le i) h)
    (by decide +kernel) g good

theorem counterexample : UniqueQuantumCounterexample 9 :=
  chart_counterexample (r := 0) (u := 2) (i := 0) (j := 0) (l := 1) forced
    (by decide) (by decide +kernel) (by decide +kernel) (by decide +kernel)
