  ray r i := Fin.ofNat 24 (decodeChunk 0x131a12d9556b0412900110d4f9a17675607bb2266c934 5 (4*r.val+i.val))
  refRay i := Fin.ofNat 24 (decodeChunk 0xbc967 5 i.val)
  num v i :=
