    ((decodeChunk 0x844466466264446666424844446226646466664464624666448446626426624444484266642246266242662462466664 4 k : ℤ)-4,(decodeChunk 0x444444424424442244464444442644246444664464444644444446446444624444444244644446444446446444424424 4 k : ℤ)-4)
