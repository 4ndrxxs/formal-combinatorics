private theorem block11 : Interval test 309 324 := interval_fin _ _ _ (by decide +kernel)
private theorem block12 : Interval test 324 345 := interval_fin _ _ _ (by decide +kernel)
private theorem all_checked : Interval test 0 345 := (interval_join (interval_join (interval_join block0 (interval_join block1 block2)) (interval_join block3 (interval_join block4 block5))) (interval_join (interval_join block6 (interval_join block7 block8)) (interval_join (interval_join block9 block10) (interval_join block11 block12))))
private theorem forced (g : Active) (good : Good g) : ∀ r i,g 0 r i=i :=
  force 1095 345 tag cl hints (by decide) (fun i h => all_checked i (Nat.zero_le i) h)
    (by decide +kernel) g good

theorem counterexample : UniqueQuantumCounterexample 11 :=
  chart_counterexample (r := 0) (u := 4) (i := 0) (j := 1) (l := 2) forced
    (by decide) (by decide +kernel) (by decide +kernel) (by decide +kernel)
