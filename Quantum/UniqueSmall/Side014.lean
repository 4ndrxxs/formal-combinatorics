private def readMask (s : ℕ) : ℕ → ℕ
  | 0 => 0
  | k+1 => bit (literalData (s+k)) ||| readMask s k
private def cl (i : ℕ) := readMask (clauseStart i) (clauseStart (i+1)-clauseStart i)
private def hints (i : ℕ) : List (ℕ×ℕ) :=
  let s:=hintStart i
  (List.range (hintStart (i+1)-s)).map fun k =>
    let z:=hintData (s+k)
    (z/65536,z%65536)
