def hintData (i : ℕ) : ℕ := (hintDataBlock (i/96) >>> (32*(i%96))) % 4294967296

private def readMask (s : ℕ) : ℕ → ℕ
  | 0 => 0
  | k+1 => bit (literalData (s+k)) ||| readMask s k
private def cl (i : ℕ) := readMask (clauseStart i) (clauseStart (i+1)-clauseStart i)
private def hints (i : ℕ) : List (ℕ×ℕ) :=
  let s:=hintStart i
  (List.range (hintStart (i+1)-s)).map fun k =>
    let z:=hintData (s+k)
    (z/65536,z%65536)
private def test := check 998 tag cl hints

private theorem block0 : Interval test 0 64 := interval_fin _ _ _ (by decide +kernel)
private theorem block1 : Interval test 64 128 := interval_fin _ _ _ (by decide +kernel)
private theorem block2 : Interval test 128 192 := interval_fin _ _ _ (by decide +kernel)
private theorem block3 : Interval test 192 256 := interval_fin _ _ _ (by decide +kernel)
private theorem block4 : Interval test 256 307 := interval_fin _ _ _ (by decide +kernel)
private theorem block5 : Interval test 307 308 := interval_fin _ _ _ (by decide +kernel)
private theorem block6 : Interval test 308 312 := interval_fin _ _ _ (by decide +kernel)
private theorem block7 : Interval test 312 319 := interval_fin _ _ _ (by decide +kernel)
private theorem block8 : Interval test 319 321 := interval_fin _ _ _ (by decide +kernel)
private theorem block9 : Interval test 321 345 := interval_fin _ _ _ (by decide +kernel)
private theorem block10 : Interval test 345 409 := interval_fin _ _ _ (by decide +kernel)
private theorem block11 : Interval test 409 412 := interval_fin _ _ _ (by decide +kernel)
private theorem all_checked : Interval test 0 412 := (interval_join (interval_join (interval_join block0 (interval_join block1 block2)) (interval_join block3 (interval_join block4 block5))) (interval_join (interval_join block6 (interval_join block7 block8)) (interval_join block9 (interval_join block10 block11))))
private theorem forced (g : Active) (good : Good g) : ∀ r i,g 0 r i=i :=
  force 998 412 tag cl hints (by decide) (fun i h => all_checked i (Nat.zero_le i) h)
    (by decide +kernel) g good

theorem counterexample : UniqueQuantumCounterexample 10 :=
  chart_counterexample (r := 0) (u := 5) (i := 0) (j := 0) (l := 1) forced
    (by decide) (by decide +kernel) (by decide +kernel) (by decide +kernel)
