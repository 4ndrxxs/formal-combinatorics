def decodeChunk (p w k : ℕ) := (p >>> (w*k)) % (2^w)
def chart : Config where
  side := 17
  four := by decide
  col a b := Fin.ofNat 17 (decodeChunk  5 (a.val*17+b.val))
  colRow a b := Fin.ofNat 17 (decodeChunk  5 (a.val*17+b.val))
  typ a b := Fin.ofNat 17 (decodeChunk  5 (a.val*17+b.val))
  typRow a b := Fin.ofNat 17 (decodeChunk  5 (a.val*17+b.val))
  symb a b := Fin.ofNat 17 (decodeChunk  5 (a.val*17+b.val))
  ray r i := Fin.ofNat 24 (decodeChunk 0xbb0d1b40cdb28b5ac2766c0d67c2646c0d66b0c9bb0d1bb0d16b022004a47a862b226b740f5bb0d14ca8d 5 (4*r.val+i.val))
  refRay i := Fin.ofNat 24 (decodeChunk 0x7a8a4 5 i.val)
  num v i :=
    let k:=4*v.val+i.val
    ((decodeChunk 0x646464466442642446644646464246248444666666626626662248446266626262266222448444484462446662446644 4 k : ℤ)-4,(decodeChunk 0x242424422446246442244242424642644444444444444444444444444444444444444444444444444426442226442244 4 k : ℤ)-4)
local instance chosen : Config := chart

