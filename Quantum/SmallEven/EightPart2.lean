private def rep (i : Fin 32) (x : Fin 4) : ℤ :=
  alphabet[(words[i.val]! / 48 ^ x.val) % 48]!
private def code (v : Fin 4 → ℤ) : ℕ :=
  ∑ x, ((v x + 27400464).toNat) * 54800929 ^ x.val
private def label (p : Cell 8) : Fin 32 := slots[p.1.val * 8 + p.2.val]!
private def witness (i : Fin 32) : Cell 8 :=
  (Fin.ofNat 8 (positions[i.val]! / 8), Fin.ofNat 8 (positions[i.val]! % 8))

theorem block : Nonempty (PartialArray 8 4 32 (evenMask 4)) := by
  apply integerModel.partialArray (evenMask 4) rep label (fun i => pivots[i.val]!) 3044496 (by decide)
  · decide +kernel
  · apply Coefficients.injective_by_code rep code (fun i => codes[i.val]!)
    · decide +kernel
    · apply StrictMono.injective
      rw [Fin.strictMono_iff_lt_succ]
      decide +kernel
  · have h : ∀ i, (evenMask 4) (witness i) = true ∧ label (witness i) = i := by decide +kernel
    exact fun i => ⟨witness i,h i⟩
  all_goals decide +kernel

#print axioms block
end SmallEven.B8_32

