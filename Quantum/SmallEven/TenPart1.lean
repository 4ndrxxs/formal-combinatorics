namespace SmallEven.B10_33
open QuantumCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 0

private def alphabet : Array IQ := #[(-3, -1), (-3, 1), (-2, 0), (-1, -1), (-1, 1), (0, 0),
  (1, -1), (1, 1), (2, 0)]
