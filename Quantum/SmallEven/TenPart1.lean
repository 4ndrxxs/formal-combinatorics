  50135]
private def codes : Array ℕ := #[82648520, 82653224, 83570504, 93942824, 93947528, 95095304,
  106668124, 107590108, 107594812, 129468020, 129948220, 140042024,
  140272520, 140551036, 141237626, 141237722, 141242426, 141472922,
