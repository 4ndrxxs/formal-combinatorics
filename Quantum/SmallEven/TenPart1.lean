  164311332, 165002820, 165007524, 175836132, 176297124, 176301828,
  186650236, 186654940, 187341724]
private def pivots : Array (Fin 5) := #[1, 2, 1, 1, 2, 1, 1, 1, 2, 1, 1, 1,
  1, 1, 0, 1, 2, 3, 1, 1, 1, 1, 4, 1,
  1, 1, 2, 1, 1, 2, 1, 2, 1]
private def positions : Array ℕ := #[32, 68, 76, 97, 41, 43, 86, 12, 78, 85, 95, 24,
  69, 14, 99, 58, 57, 56, 79, 34, 89, 65, 59, 75,
  23, 67, 31, 96, 42, 98, 87, 21, 13]
private def slots : Array (Fin 33) := #[14, 15, 16, 17, 22, 0, 0, 0, 0, 0,
  9, 14, 7, 32, 13, 0, 0, 0, 0, 0,
  23, 31, 14, 24, 11, 0, 0, 0, 0, 0,
  21, 26, 0, 14, 19, 0, 0, 0, 0, 0,
  10, 4, 28, 5, 14, 0, 0, 0, 0, 0,
