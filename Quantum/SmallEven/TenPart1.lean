  0, 0, 0, 0, 0, 9, 6, 30, 14, 20,
  0, 0, 0, 0, 0, 10, 27, 3, 29, 14]
private def rep (i : Fin 33) (x : Fin 5) : IQ :=
  alphabet[(words[i.val]! / 9 ^ x.val) % 9]!
private def code (v : Fin 5 → IQ) : ℕ :=
  ∑ x, (((v x).1 + 3).toNat + 7 * ((v x).2 + 3).toNat) * 49 ^ x.val
private def label (p : Cell 10) : Fin 33 := slots[p.1.val * 10 + p.2.val]!
private def witness (i : Fin 33) : Cell 10 :=
  (Fin.ofNat 10 (positions[i.val]! / 10), Fin.ofNat 10 (positions[i.val]! % 10))

theorem block : Nonempty (PartialArray 10 5 33 (evenMask 5)) := by
  apply goldenModel.partialArray (evenMask 5) rep label (fun i => pivots[i.val]!) (2,0) (by decide)
  · decide +kernel
  · apply Coefficients.injective_by_code rep code (fun i => codes[i.val]!)
    · decide +kernel
    · apply StrictMono.injective
      rw [Fin.strictMono_iff_lt_succ]
      decide +kernel
  · have h : ∀ i, (evenMask 5) (witness i) = true ∧ label (witness i) = i := by decide +kernel
    exact fun i => ⟨witness i,h i⟩
  all_goals decide +kernel

