theorem card80 : Realized 9 80 := by
  apply (imaginaryModel 3 (by decide)).certify
    (fun i x => alphabet80[(words80[i.val]! / 7 ^ x.val) % 7]!)
    (fun p => labels80[p.1.val * 9 + p.2.val]!)
  · decide +kernel
  · decide +kernel
  · apply (imaginaryModel 3 (by decide)).distinct_of_pivots (fun i => pivots80[i.val]!)
    decide +kernel
  all_goals decide +kernel

#print axioms card80


