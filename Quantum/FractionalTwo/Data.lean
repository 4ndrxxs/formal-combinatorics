def steps (i : ℕ) : List (ℕ×ℕ) := (List.range (start (i+1)-start i)).map fun t =>
  let v:=hints (start i+t)
  (v/512,v%512)
def checked (i : ℕ) : Bool := run db (nSource+i) (db (nSource+i)) (steps i)
def Interval (f : ℕ → Bool) (a b : ℕ) : Prop := ∀ i : ℕ, a ≤ i → i < b → f i = true
theorem interval_join {f a b c} (x : Interval f a b) (y : Interval f b c) : Interval f a c := by
  intro i hi hj;by_cases h : i<b
  · exact x i hi h
  · exact y i (by omega) hj
theorem interval_fin {f : ℕ→Bool} (a b : ℕ) (h : ∀ i : Fin (b-a),f (a+i.val)=true) : Interval f a b := by
  intro i hi hj
  simpa [Nat.add_sub_of_le hi] using h ⟨i-a,by omega⟩
def sameSource (i : ℕ) : Bool := db i == sourceMask (tags i)
end FractionalTwo
