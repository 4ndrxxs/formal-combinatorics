def idx (p : Pt) : ℕ := p.1.val*5+p.2.val
def pt (j : ℕ) : Pt := (Fin.ofNat 5 (j/5),Fin.ofNat 5 j)
def glyph (q : ℕ) : Code 21 := if h : q<24 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 21 (q-24))
def word (q : ℕ) : Word 21 := if h : q<4 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 21 (q-4))
def num (w : Word 21) : ℕ := Sum.elim (fun i => i.val) (fun i => 4+i.val) w

def model : Full 5 21 where
  dims := by decide
  label r c := glyph ((qcodes (idx r))[idx c]!)
  place dir k s := pt ((qPositions (axis dir*25+idx k))[num s]!)
  frame dir k i := Fin.ofNat 24 ((frameTable (axis dir*25+idx k))[i.val]!)
  checked := by intro dir; cases dir <;> decide +kernel
  ortho := by intro dir; cases dir <;> decide +kernel

def chart : Chart 5 21 200 8 where
  ref r c := word ((codes (idx r))[idx c]!)
  missing r c := (missing (idx r))[idx c]! == 1
  slot i := let s := (slotTable 0)[i.val]!; (pt (s/25),pt s)
  find r c := Fin.ofNat 200 ((invTable (idx r))[idx c]!)
  ax i := word i.val
  pos dir k s := pt ((cPositions (axis dir*25+idx k))[num s]!)

theorem compatible : Compatible model Core005.pattern chart where
  perm := by intro dir; cases dir <;> decide +kernel
  given := by decide +kernel
  cover := by decide +kernel
  label := by decide +kernel
  pins := by decide +kernel
  adj := by decide +kernel
  distinct := by decide +kernel

theorem counterexample : SudokuTrade.UniqueQuantumCounterexample 5 :=
  Activated.counterexample compatible Core005.clique Core005.forced
    (mixed_of_label model (r:=pt 0) (c:=pt 2) (q:=4) (by decide +kernel)
      (a:=2) (b:=3) (by decide) (by decide +kernel) (by decide +kernel))
#print axioms counterexample
end Activated.Side005
