def idx (p : Pt) : ℕ := p.1.val*7+p.2.val
def pt (j : ℕ) : Pt := (Fin.ofNat 7 (j/7),Fin.ofNat 7 j)
def glyph (q : ℕ) : Code 45 := if h : q<24 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 45 (q-24))
def word (q : ℕ) : Word 45 := if h : q<4 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 45 (q-4))
def num (w : Word 45) : ℕ := Sum.elim (fun i => i.val) (fun i => 4+i.val) w

def model : Full 7 45 where
  dims := by decide
  label r c := glyph ((qcodes (idx r))[idx c]!)
  place dir k s := pt ((qPositions (axis dir*49+idx k))[num s]!)
  frame dir k i := Fin.ofNat 24 ((frameTable (axis dir*49+idx k))[i.val]!)
  checked := by intro dir; cases dir <;> decide +kernel
  ortho := by intro dir; cases dir <;> decide +kernel

def chart : Chart 7 45 294 6 where
  ref r c := word ((codes (idx r))[idx c]!)
  missing r c := (missing (idx r))[idx c]! == 1
  slot i := let s := (slotTable 0)[i.val]!; (pt (s/49),pt s)
  find r c := Fin.ofNat 294 ((invTable (idx r))[idx c]!)
  ax i := word i.val
  pos dir k s := pt ((cPositions (axis dir*49+idx k))[num s]!)

theorem compatible : Compatible model Core007.pattern chart where
  perm := by intro dir; cases dir <;> decide +kernel
  given := by decide +kernel
  cover := by decide +kernel
  label := by decide +kernel
  pins := by decide +kernel
  adj := by decide +kernel
  distinct := by decide +kernel

theorem counterexample : SudokuTrade.UniqueQuantumCounterexample 7 :=
  Activated.counterexample compatible Core007.clique Core007.forced
    (mixed_of_label model (r:=pt 0) (c:=pt 10) (q:=20) (by decide +kernel)
      (a:=0) (b:=1) (by decide) (by decide +kernel) (by decide +kernel))
#print axioms counterexample
end Activated.Side007
