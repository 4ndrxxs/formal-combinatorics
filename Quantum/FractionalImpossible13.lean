module
public import Quantum.FractionalPartialCut

/-! A classically impossible partial Sudoku of block side 13, with an
actual rank-one quantum completion and a direct parity certificate. -/
@[expose] public section
namespace ImpossibleSudoku13
open QuantumSudoku FractionalLayouts PartialSudoku ImpossibleSudoku

def codes : Packed := ⟨8,⟩

def positions : Packed := ⟨8,⟩

def frames : Packed := ⟨5,0x180226a58691d77a39111002310c2008860a96ca00c418126f089ac0806200c4118820859a66858272c61a115708c4010c0100823915f14d66c381020804300c226d24918801104600880383aa7090a0b2e681a9e200c4110023004626b04135e2c⟩

def selected : Packed := ⟨1,0x891208181⟩

abbrev F := Fin 13
abbrev U := Fin 165
def decode (q : ℕ) : PartialSudoku.Code 165 :=
  if h : q<24 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 165 (q-24))
def label (r c t : F) : PartialSudoku.Code 165 := decode (codes[(r.val*13+c.val)*13+t.val]!)
def frame (d : Direction) (k : F) (h : Fin 4) : Fin 24 :=
  Fin.ofNat 24 (frames[(axis d*13+k.val)*4+h.val]!)
def place (d : Direction) (k : F) (s : PartialSudoku.Word 165) : Sites 13 :=
  let i := Sum.elim (fun h => h.val) (fun u => 4+u.val) s
  let w := positions[(axis d*13+k.val)*169+i]!
  (Fin.ofNat 13 (w/13),Fin.ofNat 13 (w%13))

set_option maxRecDepth 100000
set_option maxHeartbeats 0
def model : PartialSudoku.Layout 13 165 where
  dims := by decide
  label := label
  place := place
  frame := frame
  checked := by intro d; cases d <;> decide +kernel
  ortho := by intro d; cases d <;> decide +kernel

def mark (d : ℕ) (k : F) : ZMod 2 := selected[d*13+k.val]!

def proofCut : PartialSudoku.Cut model where
  row := mark 0
  col := mark 1
  block := mark 2
  on_active := by
    have cert : ∀ r c t : F,(model.label r c t).isLeft=true →
        mark 0 r+mark 1 c+mark 2 t=0 := by decide +kernel
    intro r c t
    cases h : model.label r c t with
    | inl v => exact cert r c t (by simp [h])
    | inr u => trivial
  odd := by decide +kernel

theorem quantum_completion : PartialSudoku.QuantumCompletes model.puzzle model.board := model.quantum
theorem no_classical_completion : ¬∃ f,PartialSudoku.ClassicalCompletes model.puzzle f := proofCut.impossible model
theorem counterexample :
    ∃ (p : Sites 13→Sites 13→Option (Sites 13)) (v : Grid F),
      PartialSudoku.QuantumCompletes p v ∧ ¬∃ f,PartialSudoku.ClassicalCompletes p f :=
  PartialSudoku.cut_counterexample model proofCut

#print axioms quantum_completion
#print axioms no_classical_completion
#print axioms counterexample
end ImpossibleSudoku13
