import Mathlib.NumberTheory.LSeries.PrimesInAP
import Mathlib.Tactic

/-! Elementary congruence and numerical-semigroup lemmas for the modular
Hadamard order extensions. The sole analytic input is Dirichlet's theorem. -/

namespace Hadamard.Arithmetic

theorem coprime_of_modEq {x a m : ℕ} (hx : x ≡ a [MOD m])
    (ha : a.Coprime m) : x.Coprime m :=
  hx.gcd_eq.trans ha

/-- A prime realizing two simultaneous reduced residue classes. -/
theorem prime_crt {m n a b : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (cmn : m.Coprime n) (ca : a.Coprime m) (cb : b.Coprime n) (N : ℕ) :
    ∃ p > N, p.Prime ∧ p ≡ a [MOD m] ∧ p ≡ b [MOD n] := by
  obtain ⟨z, za, zb⟩ := Nat.chineseRemainder cmn a b
  have cz := (coprime_of_modEq za ca).mul_right (coprime_of_modEq zb cb)
  obtain ⟨p, hN, hp, hz⟩ := Nat.forall_exists_prime_gt_and_modEq N (mul_ne_zero hm hn) cz
  exact ⟨p, hN, hp, ((hz.of_dvd (dvd_mul_right m n)).trans za),
    ((hz.of_dvd (dvd_mul_left n m)).trans zb)⟩

theorem two_coprime_prime {m : ℕ} (hm : m.Prime) (hm2 : 2 < m) : (2 : ℕ).Coprime m :=
  (hm.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt (by decide) hm2)).symm

theorem four_coprime_prime {m : ℕ} (hm : m.Prime) (hm2 : 2 < m) : (4 : ℕ).Coprime m :=
  (two_coprime_prime hm hm2).pow_left 2

theorem eight_coprime_prime {m : ℕ} (hm : m.Prime) (hm2 : 2 < m) : (8 : ℕ).Coprime m :=
  (two_coprime_prime hm hm2).pow_left 3

/-- If d divides A+1 and is odd, it is coprime to A-1. -/
theorem coprime_sub_one {A d : ℕ} (ha : 0 < A) (hd : d.Coprime 2)
    (h : d ∣ A + 1) : d.Coprime (A - 1) := by
  let g := d.gcd (A-1)
  have gD : g ∣ d := Nat.gcd_dvd_left _ _
  have gm : g ∣ A-1 := Nat.gcd_dvd_right _ _
  have g2 : g ∣ 2 := by
    have t := Nat.dvd_sub (gD.trans h) gm
    rwa [show A + 1 - (A - 1) = 2 by omega] at t
  have H : g ∣ d.gcd 2 := Nat.dvd_gcd gD g2
  rw [hd.gcd_eq_one] at H
  exact Nat.eq_one_of_dvd_one H

/-- Below the square of the modulus a nonzero residue witnesses that a factor
of m occurs exactly once. -/
theorem coprime_quotient {m A c k d : ℕ} (hm : m.Prime) (hc : 1 < c)
    (hc' : c < m^2) (ha : A ≡ c [MOD m^2]) (he : A = k * m * d + 1) :
    d.Coprime m := by
  apply Nat.Coprime.symm
  apply hm.coprime_iff_not_dvd.mpr
  rintro ⟨t, ht⟩
  have hu : A ≡ 1 [MOD m^2] := by
    rw [he, ht, show k * m * (m * t) + 1 = 1 + (k*t)*(m^2) by ring]
    simp [Nat.ModEq]
  have hh := hu.symm.trans ha
  change 1 % (m^2) = c % (m^2) at hh
  rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt hc'] at hh
  omega

/-- Every sufficiently large integer is generated by two positive coprime
integers. The elementary explicit bound a*b also covers a or b equal to one. -/
theorem coprime_coins {a b t : ℕ} (cop : a.Coprime b)
    (hb : 0 < b) (ht : a*b ≤ t) : ∃ x y, t = a*x + b*y := by
  by_cases hb1 : b = 1
  · exact ⟨0, t, by simp [hb1]⟩
  obtain ⟨i, _, hi⟩ := Nat.exists_mul_mod_eq_one_of_coprime cop (by omega)
  let x := (t*i)%b
  have hx : x < b := Nat.mod_lt _ hb
  have hax : a*x ≤ t := (Nat.mul_le_mul_left a hx.le).trans ht
  have hinv : a*i ≡ 1 [MOD b] := by
    simpa [Nat.ModEq, Nat.mod_eq_of_lt (show 1 < b by omega)] using hi
  have hcong : a*x ≡ t [MOD b] := by
    calc
      a*x ≡ a*(t*i) [MOD b] := (Nat.mod_modEq _ _).mul_left _
      _ = (a*i)*t := by ring
      _ ≡ 1*t [MOD b] := hinv.mul_right _
      _ = t := one_mul _
  obtain ⟨y, hy⟩ := (Nat.modEq_iff_dvd' hax).mp hcong
  exact ⟨x, y, by omega⟩

/-- The numerical part of a seed-and-two-extensions construction. The
threshold is explicit in the chosen generators. -/
theorem progression_bound {m n₀ u v : ℕ} (hm : 0 < m)
    (c4 : (4 : ℕ).Coprime m) (huv : u.gcd v = m) (hv : 0 < v)
    (h₀ : 4 ∣ n₀) {n : ℕ}
    (hn : n₀ + 4*m*((u/m)*(v/m)) ≤ n) (h4 : 4 ∣ n) (hr : n ≡ n₀ [MOD m]) :
    ∃ x y, n = n₀ + 4*u*x + 4*v*y := by
  have hmn : n₀ ≤ n := by omega
  have hmu : m ∣ u := huv ▸ Nat.gcd_dvd_left u v
  have hmv : m ∣ v := huv ▸ Nat.gcd_dvd_right u v
  let a := u/m
  let b := v/m
  have ua : m*a = u := Nat.mul_div_cancel' hmu
  have vb : m*b = v := Nat.mul_div_cancel' hmv
  have cm : m*(a.gcd b) = m := by simpa [← Nat.gcd_mul_left, ua, vb] using huv
  have cop : a.Coprime b := by
    change a.gcd b = 1
    apply Nat.eq_of_mul_eq_mul_left hm
    simpa using cm
  have hb : 0 < b := by
    by_contra! h
    have hb0 : b = 0 := Nat.le_zero.mp h
    rw [hb0, Nat.mul_zero] at vb
    exact (Nat.ne_of_gt hv) vb.symm
  have d4 : 4 ∣ n-n₀ := Nat.dvd_sub h4 h₀
  have dm := (Nat.modEq_iff_dvd' hmn).mp hr.symm
  obtain ⟨t, dt⟩ := c4.mul_dvd_of_dvd_of_dvd d4 dm
  have eqn : n = n₀ + 4*m*t := by omega
  have large : a*b ≤ t := by
    apply Nat.le_of_mul_le_mul_left (c := 4*m)
    · change 4*m*((u/m)*(v/m)) ≤ 4*m*t
      omega
    · positivity
  obtain ⟨x,y,xy⟩ := coprime_coins cop hb large
  refine ⟨x,y, ?_⟩
  rw [eqn, xy, ← ua, ← vb]
  ring

theorem eventually_in_progression {m n₀ u v : ℕ} (hm : 0 < m)
    (c4 : (4 : ℕ).Coprime m) (huv : u.gcd v = m) (hv : 0 < v) (h₀ : 4 ∣ n₀) :
    ∃ B, ∀ n ≥ B, 4 ∣ n → n ≡ n₀ [MOD m] → ∃ x y, n = n₀ + 4*u*x + 4*v*y :=
  ⟨_, fun _ hn h4 hr => progression_bound hm c4 huv hv h₀ hn h4 hr⟩

end Hadamard.Arithmetic
