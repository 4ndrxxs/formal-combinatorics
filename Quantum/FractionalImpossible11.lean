module
public import Quantum.FractionalPartialCut

/-! A classically impossible partial Sudoku of block side 11, with an
actual rank-one quantum completion and a direct parity certificate. -/
@[expose] public section
namespace ImpossibleSudoku11
open QuantumSudoku FractionalLayouts PartialSudoku ImpossibleSudoku

def codes : Packed := ⟨8,⟩

def positions : Packed := ⟨7,⟩

def frames : Packed := ⟨5,0x2d95592cf700c2218022100610886018022089aca21d124df04b586104032c9f10204758dc1251574ceac0b44cb41a61882000c410806210c010886000443280819512d42e767886a3bab00898d8dd8618022⟩

def selected : Packed := ⟨1,0x1030a408a⟩

abbrev F := Fin 11
abbrev U := Fin 117
def decode (q : ℕ) : PartialSudoku.Code 117 :=
  if h : q<24 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 117 (q-24))
def label (r c t : F) : PartialSudoku.Code 117 := decode (codes[(r.val*11+c.val)*11+t.val]!)
def frame (d : Direction) (k : F) (h : Fin 4) : Fin 24 :=
  Fin.ofNat 24 (frames[(axis d*11+k.val)*4+h.val]!)
def place (d : Direction) (k : F) (s : PartialSudoku.Word 117) : Sites 11 :=
  let i := Sum.elim (fun h => h.val) (fun u => 4+u.val) s
  let w := positions[(axis d*11+k.val)*121+i]!
  (Fin.ofNat 11 (w/11),Fin.ofNat 11 (w%11))

set_option maxRecDepth 100000
set_option maxHeartbeats 0
def model : PartialSudoku.Layout 11 117 where
  dims := by decide
  label := label
  place := place
  frame := frame
  checked := by intro d; cases d <;> decide +kernel
  ortho := by intro d; cases d <;> decide +kernel

def mark (d : ℕ) (k : F) : ZMod 2 := selected[d*11+k.val]!

def proofCut : PartialSudoku.Cut model where
  row := mark 0
  col := mark 1
  block := mark 2
  on_active := by
    have cert : ∀ r c t : F,(model.label r c t).isLeft=true →
        mark 0 r+mark 1 c+mark 2 t=0 := by decide +kernel
    intro r c t
    cases h : model.label r c t with
    | inl v => exact cert r c t (by simp [h])
    | inr u => trivial
  odd := by decide +kernel

theorem quantum_completion : PartialSudoku.QuantumCompletes model.puzzle model.board := model.quantum
theorem no_classical_completion : ¬∃ f,PartialSudoku.ClassicalCompletes model.puzzle f := proofCut.impossible model
theorem counterexample :
    ∃ (p : Sites 11→Sites 11→Option (Sites 11)) (v : Grid F),
      PartialSudoku.QuantumCompletes p v ∧ ¬∃ f,PartialSudoku.ClassicalCompletes p f :=
  PartialSudoku.cut_counterexample model proofCut

#print axioms quantum_completion
#print axioms no_classical_completion
#print axioms counterexample
end ImpossibleSudoku11
