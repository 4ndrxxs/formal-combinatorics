private def locations : Array ℕ := #[51, 53, 41, 38, 48, 13, 34, 30, 43, 8, 36, 31,
  26, 4, 16, 15, 2, 1, 0, 17, 22, 5, 10, 9,
  3, 24, 25, 14, 28, 40, 19, 27, 45, 18, 29, 32,
  6, 44, 7, 42, 52, 39, 47, 12, 50, 35, 33]
private def rep (i : Fin 47) (x : Fin 9) : IQ :=
  alphabet[(words[i.val]! / 22^x.val) % 22]!
private def lab (r s : Index (Fin 3)) : Fin 47 :=
  labels[(3*r.1.val+r.2.val)*9+3*s.1.val+s.2.val]!
private def pos (k : ℕ) : Index (Fin 3) := (Fin.ofNat 3 (k/3),Fin.ofNat 3 k)
private def code (v : Fin 9 → IQ) : ℕ :=
  ∑ x, (((v x).1+320).toNat + ((v x).2+320).toNat*641)*641^(2*x.val)

theorem realized : Realizes 3 47 := by
  apply of_certificate (imaginaryModel 3 (by decide)) rep lab (fun i => pivots[i.val]!) (40,0) (by decide)
  · decide +kernel
  · apply Coefficients.injective_by_code rep code (fun i => codes[i.val]!)
    · decide +kernel
    · apply StrictMono.injective
      rw [Fin.strictMono_iff_lt_succ]
      decide +kernel
  · have hits : ∀ i : Fin 47, lab (pos (locations[i.val]! / 9)) (pos (locations[i.val]! % 9))=i := by decide +kernel
    exact fun i => ⟨_,_,hits i⟩
  all_goals decide +kernel

end C47

