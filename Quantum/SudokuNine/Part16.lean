private def rep (i : Fin 64) (x : Fin 9) : IQ :=
  alphabet[(words[i.val]! / 18^x.val) % 18]!
private def lab (r s : Index (Fin 3)) : Fin 64 :=
  labels[(3*r.1.val+r.2.val)*9+3*s.1.val+s.2.val]!
private def pos (k : ℕ) : Index (Fin 3) := (Fin.ofNat 3 (k/3),Fin.ofNat 3 k)
private def code (v : Fin 9 → IQ) : ℕ :=
  ∑ x, (((v x).1+400).toNat + ((v x).2+400).toNat*801)*801^(2*x.val)

theorem realized : Realizes 3 64 := by
  apply of_certificate (imaginaryModel 3 (by decide)) rep lab (fun i => pivots[i.val]!) (100,0) (by decide)
  · decide +kernel
  · apply Coefficients.injective_by_code rep code (fun i => codes[i.val]!)
    · decide +kernel
    · apply StrictMono.injective
      rw [Fin.strictMono_iff_lt_succ]
      decide +kernel
  · have hits : ∀ i : Fin 64, lab (pos (locations[i.val]! / 9)) (pos (locations[i.val]! % 9))=i := by decide +kernel
    exact fun i => ⟨_,_,hits i⟩
  all_goals decide +kernel

