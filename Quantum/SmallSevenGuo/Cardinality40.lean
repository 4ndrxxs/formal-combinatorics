def minorWitness (a b : ℕ) : ℕ × ℕ :=
  (minorWitnesses[a]?.getD [])[b]?.getD (0, 0)

theorem minor_witness : ∀ a b : Fin 40, a ≠ b →
    let (k, l) := minorWitness a b
    k < 7 ∧ l < 7 ∧ (0 < (data.minorBound a b k l).1 ∨ (data.minorBound a b k l).2 < 0) := by
  decide +kernel

theorem separating_minors (a b : Fin 40) (hab : a ≠ b) : ∃ k l : Fin 7,
    0 < (data.minorBound a b k l).1 ∨ (data.minorBound a b k l).2 < 0 := by
  obtain ⟨hk, hl, h⟩ := minor_witness a b hab
  exact ⟨⟨(minorWitness a b).1, hk⟩, ⟨(minorWitness a b).2, hl⟩, h⟩

theorem denominators_positive : ∀ i : Fin 3,
    0 < (data.radicands[i.val]?.getD (0, [])).1 := by decide +kernel

theorem coordinate_masks : ∀ a : Fin 40, ∀ k : Fin 7,
    (data.coord a k).all (fun t => t.1 < 8) = true := by decide +kernel

theorem exists_quantumLatinSquare : ∃ q : QuantumLatinSquare 7, q.cardinality = 40 := by
  have hs := scalars_positive.2.1
  have hc := scalars_positive.1
  obtain ⟨x, hx, hp⟩ := Interval.exists_root hs basePolynomial rootInterval root_bracket.1
    (Or.inr ⟨root_bracket.2.1, root_bracket.2.2.1⟩)
  exact data.exists_quantumLatinSquare x (by decide) hs hc hx denominators_positive factors_correct
    sqrt_enclosures coordinate_masks bounds_correct separating_minors labels_in_range
    (row_dot_zero x hp) (column_dot_zero x hp) all_labels_used

end QLS7.Cardinality40
