module

public import Quantum.SmallSevenGuo.Certificate.Existence

public import Quantum.SmallSevenGuo.Cardinality40.Orthogonality


/-!
# An algebraic certificate of cardinality 40
-/

@[expose] public section
set_option maxHeartbeats 0

set_option maxRecDepth 1000000

namespace QLS7.Cardinality40

theorem factors_correct : ∀ m : Fin 8,
    IntPolynomial.trim (data.makeFactor m.val) = factors[m.val]?.getD [] := by
  decide +kernel

theorem dimensions : rays.length = 40 ∧ grid.length = 7 ∧
    (rays.all (fun v => v.length == 7)) = true ∧
    (grid.all (fun r => r.length == 7)) = true := by decide +kernel

theorem labels_in_range : ∀ i j : Fin 7, data.label i.val j.val < 40 := by decide +kernel

theorem all_labels_used : ∀ a : Fin 40, ∃ i j : Fin 7,
    data.label i.val j.val = a.val := by decide +kernel

theorem masks_in_range : rays.all (fun v => v.all (fun e =>
    e.all (fun t => t.1 < 8))) = true := by decide +kernel

theorem unit_coordinates : ∀ a : Fin 40, ∃ k : Fin 7,
    data.coord a.val k.val = [(0, [coordinateScale])] ∨
    data.coord a.val k.val = [(0, [-coordinateScale])] := by decide +kernel

theorem scalars_positive : coordinateScale > 0 ∧ intervalScale > 0 ∧
    radicands.all (fun r => r.1 > 0) = true := by decide +kernel

theorem pair_count : data.orthPairs.length = 294 := by decide +kernel

theorem pairs_cover : data.orthPairs = certifiedPairs := by decide +kernel

theorem root_bracket : rootInterval.1 < rootInterval.2 ∧
    (Interval.eval intervalScale basePolynomial 1 (rootInterval.1, rootInterval.1)).1 > 0 ∧
    (Interval.eval intervalScale basePolynomial 1 (rootInterval.2, rootInterval.2)).2 < 0 ∧
    (Interval.eval intervalScale derivative 1 rootInterval).2 < 0 := by decide +kernel

theorem sqrt_enclosures : ∀ i : Fin 3,
    let b := data.radBounds i.val
    let s := sqrtIntervals[i.val]?.getD (0, 0)
    0 < b.1 ∧ b.1 ≤ b.2 ∧ 0 < s.1 ∧ s.1 ≤ s.2 ∧
    s.1 * s.1 ≤ b.1 * intervalScale ∧ s.2 * s.2 ≥ b.2 * intervalScale := by decide +kernel

theorem bounds_correct : ∀ a : Fin 40, ∀ k : Fin 7,
    let b := data.elemBound (data.coord a.val k.val)
    let c := data.bound a.val k.val
    c.1 ≤ b.1 ∧ b.2 ≤ c.2 := by decide +kernel

theorem minors_nonzero : minorCoordinates.all data.separationOK = true := by decide +kernel

theorem minor_coverage : minorCoordinates.map (fun (a, b, _, _) => (a, b)) = data.allRayPairs ∧
    minorCoordinates.length = 780 := by decide +kernel

theorem multiplicities : ((List.range 40).filter (fun a => data.multiplicity a == 1)).length = 31 ∧
    ((List.range 40).filter (fun a => data.multiplicity a == 2)).length = 9 := by decide +kernel

