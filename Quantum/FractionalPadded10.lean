def selected : ℕ → Packed
  | 0 => ⟨1,0x26098260982609826⟩
  | 1 => ⟨1,0xe0380e0380e0380e⟩
  | 2 => ⟨1,0x341a05108c460341a⟩
  | _ => ⟨1,0⟩

def index (p : P) : ℕ := p.1.val*10+p.2.val
def decode (q : ℕ) : PartialSudoku.Code 96 :=
  if h:q<24 then .inl ⟨q,h⟩ else .inr (Fin.ofNat 96 (q-24))
def label (r c : P) : PartialSudoku.Code 96 := decode ((codes (index r))[index c]!)
def frame (d : Direction) (k : P) (i : Fin 4) :=
  Fin.ofNat 24 ((frames (axis d*100+index k))[i.val]!)
def place (d : Direction) (k : P) (s : PartialSudoku.Word 96) : P :=
  let i := Sum.elim (fun h => h.val) (fun u => 4+u.val) s
  let pos := (placements (axis d*100+index k))[i]!
  (Fin.ofNat 10 (pos/10),Fin.ofNat 10 (pos%10))
def mark (d : Direction) (k : P) : ZMod 2 := (selected (axis d))[index k]!

set_option maxRecDepth 120000
set_option maxHeartbeats 0
def model : PhysicalSudokuCut.Full 10 96 where
  dims := by decide
  label := label
  place := place
  frame := frame
  checked := by intro d; cases d <;> decide +kernel
  ortho := by intro d; cases d <;> decide +kernel

def parity : PhysicalSudokuCut.Cut model where
  mark := mark
  active := by decide +kernel
  odd := by decide +kernel

theorem counterexample : ∃ (p : P→P→Option P) (v : Grid F),
    QuantumCompletes p v ∧ ¬∃ f, ClassicalCompletes p f :=
  PhysicalSudokuCut.counterexample model parity

#print axioms counterexample
end ImpossiblePadded10
