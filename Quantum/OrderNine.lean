module

public import Quantum.Exact

/-! Explicit certificates for order-nine quantum Latin squares. Each word
encodes nine sixth-root exponents, with the coordinate at index zero dephased.
The Gram and projective tests are checked by Lean's kernel. -/

@[expose] public section
namespace OrderNine
open QuantumCertificate

set_option maxRecDepth 100000
set_option maxHeartbeats 0

private def sixth : Array IQ := #[(2,0), (1,1), (-1,1), (-2,0), (-1,-1), (1,-1)]

private def unpack (a : ℕ) (x : Fin 9) : IQ := sixth[(a / 6 ^ x.val) % 6]!


